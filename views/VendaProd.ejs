<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update User</title>
</head>
<body>
  <h1>Users</h1>
  <ul>
    <% users.forEach(user => { %>
      <li>
        <%= user.name %> (Age: <%= user.age %>)
        <!-- Button that triggers the POST request to update the user's age -->
        <form action="/update/<%= user.id %>" method="POST">
          <button type="submit">Increment Age</button>
        </form>
      </li>
    <% }) %>
  </ul>
</body>
</html>