{
	"compilerOptions": {
		"target": "es2018",
		"lib": ["dom", "es5", "es6", "ES2018"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"allowJs": true,
		"outDir": "./public/js",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": true,
		"strictPropertyInitialization": false,
		"typeRoots": [
			"./node_modules/@types",
			"./config/types"  // Adicione o diretório onde os tipos personalizados estão
		  ]
	},
	"include": ["src/**/**/*", "index.ts"],
	"exclude": ["node_modules", "dist"],
	"ts-node": {
		"files": true
	}
}